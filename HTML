<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="./style.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Math Breaks</title>

    <!-- MathJax configuration (must come BEFORE the MathJax script) -->
    <script>
      window.MathJax = {
        options: {
          enableMenu: true            // right-click context menu
        },
        chtml: {
          displayOverflow: 'linebreak', // display equations wrap instead of overflowing
          linebreaks: {
            inline: true,             // allow breaking
            width: '100%',            // break to fit the container width
            lineleading: 0.2
          }
        }
      };
    </script>
    <style>
      /* No scrolling: the equation must wrap, never scroll */
      mjx-container[display="true"] { max-width: 100%; overflow: visible; }
      body { overflow-wrap: anywhere; }
    </style>

    <script>
      // Re-typeset when the width changes (rotation, resizing the window/devtools)
      (function () {
        var t, lastW = window.innerWidth;
        window.addEventListener('resize', function () {
          clearTimeout(t);
          t = setTimeout(function () {
            if (window.innerWidth === lastW || !window.MathJax || !MathJax.startup) return;
            lastW = window.innerWidth;
            MathJax.startup.promise = MathJax.startup.promise.then(function () {
              MathJax.startup.document.state(0);
              return MathJax.typesetPromise();
            });
          }, 150);
        });
      })();
    </script>

    <!-- MathJax 4: automatic line breaking + context menu -->
    <script id="MathJax-script" async
            src="https://cdn.jsdelivr.net/npm/mathjax@4/mml-chtml.js"></script>
  </head>
  <body>

<math display="block">
  <mrow>
    <mi mathvariant="script">L</mi>
    <mo linebreak="goodbreak" linebreakstyle="before">=</mo>
    <mo linebreak="nobreak">&minus;</mo>
    <mfrac>
      <mn>1</mn>
      <mn>4</mn>
    </mfrac>
    <msubsup>
      <mi>F</mi>
      <mrow>
        <mi>&mu;</mi>
        <mi>&nu;</mi>
      </mrow>
      <mi>a</mi>
    </msubsup>
    <msup>
      <mi>F</mi>
      <mrow>
        <mi>a</mi>
        <mi>&mu;</mi>
        <mi>&nu;</mi>
      </mrow>
    </msup>

    <mo linebreak="goodbreak" linebreakstyle="before">+</mo>

    <mi>i</mi>
    <mover accent="true">
      <mi>&psi;</mi>
      <mo>&macr;</mo>
    </mover>
    <menclose notation="updiagonalstrike">
      <mi>D</mi>
    </menclose>
    <mi>&psi;</mi>

    <mo linebreak="goodbreak" linebreakstyle="before">+</mo>
    <mtext>h.c.</mtext>

    <mo linebreak="goodbreak" linebreakstyle="before">+</mo>
    <msup>
      <mrow>
        <mo fence="true" form="prefix">|</mo>
        <msub>
          <mi>D</mi>
          <mi>&mu;</mi>
        </msub>
        <mi>h</mi>
        <mo fence="true" form="postfix">|</mo>
      </mrow>
      <mn>2</mn>
    </msup>

    <mo linebreak="goodbreak" linebreakstyle="before">&minus;</mo>
    <mi>V</mi>
    <mo stretchy="false">(</mo>
    <mi>h</mi>
    <mo stretchy="false">)</mo>

    <mo linebreak="goodbreak" linebreakstyle="before">+</mo>
    <msub>
      <mover accent="true">
        <mi>&psi;</mi>
        <mo>&macr;</mo>
      </mover>
      <mi>i</mi>
    </msub>
    <msub>
      <mi>Y</mi>
      <mrow>
        <mi>i</mi>
        <mi>j</mi>
      </mrow>
    </msub>
    <mi>h</mi>
    <msub>
      <mi>&psi;</mi>
      <mi>j</mi>
    </msub>

    <mo linebreak="goodbreak" linebreakstyle="before">+</mo>
    <mtext>h.c.</mtext>
  </mrow>
</math>

  </body>
</html>
